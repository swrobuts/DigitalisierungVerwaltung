# Frontend ENV — Vite kompiliert diese Werte zur Build-Zeit ins Bundle.
# Für `npm run dev` lokal: kopiere zu .env und fülle den ANON_KEY aus
# /root/supabase/docker/.env auf dem VPS.

VITE_SUPABASE_URL=https://supabase.butscher.cloud
VITE_SUPABASE_ANON_KEY=__aus_/root/supabase/docker/.env_ablesen__
VITE_AUTH_REDIRECT=https://amt.butscher.cloud/auth/callback
